    },
    {
      "id": "event.wifi.connected",
      "version": 1,
      "category": "event",
      "flow": "event",
      "icon": "wifi",
      "name": {
        "ru": "Wi-Fi подключён",
        "en": "Wi-Fi connected"
      },
      "description": {
        "ru": "Срабатывает, когда компьютер подключается к Wi-Fi сети (можно указать имя сети). Источник — NetworkManager (nmcli monitor), только чтение: сети не включаются и не сканируются.",
        "en": "Fires when the computer connects to a Wi-Fi network (a network name can be given). The source is NetworkManager (nmcli monitor), read-only: nothing is switched on or scanned."
      },
      "example": {
        "ru": "Подключились к домашней сети → включить звук.",
        "en": "Connected to the home network → turn the sound on."
      },
      "inputs": [
        {
          "id": "ssid_filter",
          "type": "text",
          "label": {
            "ru": "Имя сети",
            "en": "Network name"
          },
          "default": "",
          "literal": true
        }
      ],
      "outputs": [
        {
          "id": "exec",
          "type": "exec",
          "label": {
            "ru": "Запуск",
            "en": "Start"
          }
        },
        {
          "id": "ssid",
          "type": "text",
          "label": {
            "ru": "Сеть",
            "en": "Network"
          },
          "default": ""
        }
      ],
      "source": {
        "emits": "wifi.connected",
        "src": "wifi"
      },
      "executor": {
        "kind": "builtin",
        "ref": "event"
      },
      "capabilities": [
        "trigger.network"
      ],
      "changes_state": false,
      "side_effects": false
    },
    {
      "id": "event.usb.connected",
      "version": 1,
      "category": "event",
      "flow": "event",
      "icon": "usb",
      "name": {
        "ru": "USB-устройство подключено",
        "en": "USB device connected"
      },
      "description": {
        "ru": "Срабатывает, когда подключается USB-устройство: по умолчанию накопитель с файловой системой (флешка, диск), можно выбрать «другое» или «любое». Источник — udev (udevadm monitor), только чтение.",
        "en": "Fires when a USB device is plugged in: by default a storage drive with a filesystem (flash drive, disk); \"other\" or \"any\" can be chosen. The source is udev (udevadm monitor), read-only."
      },
      "example": {
        "ru": "Подключили флешку → открыть её.",
        "en": "A flash drive was plugged in → open it."
      },
      "inputs": [
        {
          "id": "kind_filter",
          "type": "text",
          "label": {
            "ru": "Что",
            "en": "What"
          },
          "default": "storage",
          "literal": true,
          "choices": [
            "storage",
            "other",
            "any"
          ],
          "choice_labels": {
            "ru": {
              "storage": "накопитель",
              "other": "другое",
              "any": "любое"
            },
            "en": {
              "storage": "storage",
              "other": "other",
              "any": "any"
            }
          }
        },
        {
          "id": "label_filter",
          "type": "text",
          "label": {
            "ru": "Метка или название",
            "en": "Label or name"
          },
          "default": "",
          "literal": true
        }
      ],
      "outputs": [
        {
          "id": "exec",
          "type": "exec",
          "label": {
            "ru": "Запуск",
            "en": "Start"
          }
        },
        {
          "id": "label",
          "type": "text",
          "label": {
            "ru": "Метка",
            "en": "Label"
          },
          "default": ""
        },
        {
          "id": "device",
          "type": "text",
          "label": {
            "ru": "Устройство",
            "en": "Device"
          },
          "default": ""
        },
        {
          "id": "kind",
          "type": "text",
          "label": {
            "ru": "Вид (storage или other)",
            "en": "Kind (storage or other)"
          },
          "default": ""
        }
      ],
      "source": {
        "emits": "usb.connected",
        "src": "usb"
      },
      "executor": {
        "kind": "builtin",
        "ref": "event"
      },
      "capabilities": [
        "trigger.usb"
      ],
      "changes_state": false,
      "side_effects": false
    },
    {
      "id": "event.notification.received",
      "version": 1,
      "category": "event",
      "flow": "event",
      "icon": "bell",
      "name": {
        "ru": "Пришло уведомление",
        "en": "Notification received"
      },
      "description": {
        "ru": "Срабатывает, когда какое-то приложение показывает уведомление (можно указать приложение). Это ОТДЕЛЬНОЕ право: оболочка подсматривает за сообщениями уведомлений на шине сеанса. Заголовок и текст достаются только этой команде и нигде не сохраняются; в журнал попадает лишь имя приложения. Свои уведомления («Serpantinum») и обновления прежних уведомлений пропускаются.",
        "en": "Fires when an application shows a notification (an application can be given). This is a SEPARATE right: the shell observes notification messages on the session bus. The title and text go only to this command and are never stored; only the application name is logged. Notifications from \"Serpantinum\" itself and updates of earlier notifications are skipped."
      },
      "example": {
        "ru": "Пришло уведомление от Telegram → мигнуть подсветкой.",
        "en": "A Telegram notification arrived → flash a light."
      },
      "inputs": [
        {
          "id": "app_filter",
          "type": "text",
          "label": {
            "ru": "Приложение",
            "en": "Application"
          },
          "default": "",
          "literal": true
        }
      ],
      "outputs": [
        {
          "id": "exec",
          "type": "exec",
          "label": {
            "ru": "Запуск",
            "en": "Start"
          }
        },
        {
          "id": "app",
          "type": "text",
          "label": {
            "ru": "Приложение",
            "en": "Application"
          },
          "default": ""
        },
        {
          "id": "title",
          "type": "text",
          "label": {
            "ru": "Заголовок",
            "en": "Title"
          },
          "default": "",
          "log": "length"
        },
        {
          "id": "body",
          "type": "text",
          "label": {
            "ru": "Текст",
            "en": "Body"
          },
          "default": "",
          "log": "length"
        }
      ],
      "source": {
        "emits": "notification.received",
        "src": "notifications"
      },
      "executor": {
        "kind": "builtin",
        "ref": "event"
      },
      "capabilities": [
        "trigger.notifications"
      ],
      "changes_state": false,
      "side_effects": false
    }
  ]
}