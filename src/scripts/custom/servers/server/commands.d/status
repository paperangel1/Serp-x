#!/bin/sh
# One JSON object with the numbers the widget shows. No jq needed.
NODE_CONTAINER=${NODE_CONTAINER:-remnanode}
s1=$(awk '/^cpu /{idle=$5+$6; t=0; for(i=2;i<=NF;i++) t+=$i; print idle, t}' /proc/stat)
sleep 0.5
s2=$(awk '/^cpu /{idle=$5+$6; t=0; for(i=2;i<=NF;i++) t+=$i; print idle, t}' /proc/stat)
cpu=$(echo "$s1 $s2" | awk '{di=$3-$1; dt=$4-$2; if (dt>0) printf "%d", (1-di/dt)*100+0.5; else print 0}')
set -- $(cat /proc/loadavg); l1=$1; l5=$2; l15=$3
mt=$(awk '/^MemTotal:/{print $2}' /proc/meminfo); ma=$(awk '/^MemAvailable:/{print $2}' /proc/meminfo)
set -- $(df -P / | awk 'NR==2{print $5+0, $2, $3}'); dpct=$1; dtot=$2; dused=$3
up=$(awk '{printf "%d", $1}' /proc/uptime)
host=$(hostname 2>/dev/null | tr -cd 'A-Za-z0-9._-')
kern=$(uname -r | tr -cd 'A-Za-z0-9._+-')
dock=null; node=null
if command -v docker >/dev/null 2>&1; then
    dock=$(docker ps -q 2>/dev/null | wc -l | tr -d ' ')
    r=$(docker inspect -f '{{.State.Running}}' "$NODE_CONTAINER" 2>/dev/null)
    [ "$r" = "true" ] && node=true; [ "$r" = "false" ] && node=false
fi
printf '{"cpu":%s,"load":[%s,%s,%s],"memTotalKb":%s,"memAvailKb":%s,"diskPct":%s,"diskTotalKb":%s,"diskUsedKb":%s,"uptime":%s,"host":"%s","kernel":"%s","dockerRunning":%s,"nodeRunning":%s}\n' \
    "${cpu:-0}" "$l1" "$l5" "$l15" "${mt:-0}" "${ma:-0}" "${dpct:-0}" "${dtot:-0}" "${dused:-0}" "${up:-0}" "$host" "$kern" "$dock" "$node"
