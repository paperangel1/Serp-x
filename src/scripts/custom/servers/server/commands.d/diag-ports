#!/bin/sh
echo "== Слушающие порты =="; ss -tulnp 2>/dev/null | head -n 40
echo; echo "== Брандмауэр =="
if command -v ufw >/dev/null 2>&1; then ufw status 2>/dev/null | head -n 30
elif command -v nft >/dev/null 2>&1; then nft list ruleset 2>/dev/null | head -n 30
elif command -v iptables >/dev/null 2>&1; then iptables -S 2>/dev/null | head -n 30
else echo "не найдено ufw/nft/iptables"; fi
