        }
      ],
      "outputs": [
        {
          "id": "exec",
          "type": "exec",
          "label": {
            "ru": "Запуск",
            "en": "Start"
          }
        },
        {
          "id": "server",
          "type": "text",
          "label": {
            "ru": "Идентификатор",
            "en": "Id"
          },
          "default": ""
        },
        {
          "id": "server_name",
          "type": "text",
          "label": {
