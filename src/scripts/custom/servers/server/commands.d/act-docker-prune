#!/bin/sh
# serp-timeout: 180
command -v docker >/dev/null 2>&1 || { echo "docker не найден"; exit 1; }
echo "Удаляю неиспользуемые образы и кэш сборки (тома и работающие контейнеры не затрагиваются)…"
