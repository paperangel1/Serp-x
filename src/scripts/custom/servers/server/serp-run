#!/bin/sh
# Serpantinum forced-command entry point. Installed as /usr/local/sbin/serp-run and referenced from
# authorized_keys as: restrict,command="/usr/local/sbin/serp-run" ssh-ed25519 ...
# The client may only send ONE token ([a-z0-9-], max 32 chars) in SSH_ORIGINAL_COMMAND; nothing else is run.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

tok=${SSH_ORIGINAL_COMMAND:-status}
case "$tok" in
    *[!a-z0-9-]*|'') echo "serp-run: bad command token" >&2; exit 64 ;;
esac
if [ "${#tok}" -gt 32 ]; then echo "serp-run: token too long" >&2; exit 64; fi

SERP_ROOT_HELPER=${SERP_ROOT_HELPER:-/usr/local/sbin/serp-root}
if [ "$(id -u)" = "0" ]; then
    exec "$SERP_ROOT_HELPER" "$tok" 2>&1
fi
exec sudo -n "$SERP_ROOT_HELPER" "$tok" 2>&1
