{
 "nodes": [
  {
   "id": "event.time_at",
   "version": 1,
   "category": "event",
   "flow": "event",
   "icon": "clock",
   "name": {
    "ru": "В заданное время",
    "en": "At a given time"
   },
   "description": {
    "ru": "Запускает команду каждый день (или по выбранным дням) в указанное время. Если компьютер спал в это время, поведение задаёт «Пропущенный запуск».",
    "en": "Starts the command every day (or on the chosen days) at the given time. If the computer was asleep, «Missed run» decides what happens."
   },
   "example": {
    "ru": "В 08:00 по будням → уведомление «Планёрка».",
    "en": "At 08:00 on weekdays → notification \"Stand-up\"."
   },
   "inputs": [
    {
     "id": "at",
     "type": "time",
     "label": {
      "ru": "Время",
      "en": "Time"
     },
     "default": "08:00",
     "literal": true
    },
    {
     "id": "days",
     "type": "text",
     "label": {
      "ru": "Дни",
      "en": "Days"
     },
     "default": "daily",
     "literal": true,
     "choices": [
      "daily",
      "weekdays",
      "weekends",
      "mon",
      "tue",
      "wed",
      "thu",
      "fri",
      "sat",
      "sun"
     ],
     "choice_labels": {
      "ru": {
       "daily": "каждый день",
       "weekdays": "по будням",
       "weekends": "по выходным",
       "mon": "понедельник",
       "tue": "вторник",
       "wed": "среда",
       "thu": "четверг",
       "fri": "пятница",
       "sat": "суббота",
       "sun": "воскресенье"
      },
      "en": {
       "daily": "every day",
       "weekdays": "weekdays",
       "weekends": "weekends",
       "mon": "Monday",
       "tue": "Tuesday",
       "wed": "Wednesday",
       "thu": "Thursday",
       "fri": "Friday",
       "sat": "Saturday",
       "sun": "Sunday"
      }
     }
    },
    {
     "id": "missed",
     "type": "text",
     "label": {
      "ru": "Пропущенный запуск",
      "en": "Missed run"
     },
     "default": "skip",
     "literal": true,
     "choices": [
      "skip",
      "run_once"
     ],
     "choice_labels": {
      "ru": {
       "skip": "пропустить",
       "run_once": "выполнить один раз"
      },
      "en": {
       "skip": "skip",
       "run_once": "run once"
      }
     }
    }
   ],
   "outputs": [
    {
     "id": "exec",
     "type": "exec",
     "label": {
      "ru": "Запуск",
      "en": "Start"
     }
    },
    {
     "id": "time",
     "type": "time",
     "label": {
      "ru": "Время",
      "en": "Time"
     },
     "default": "00:00"
    },
    {
     "id": "weekday",
     "type": "text",
     "label": {
      "ru": "День недели",
      "en": "Weekday"
     },
     "default": ""
    }
   ],
   "source": {
    "emits": "time.at",
    "src": "time"
   },
   "executor": {
    "kind": "builtin",
    "ref": "event"
   },
   "capabilities": [
    "trigger.time"
   ],
   "changes_state": false,
   "side_effects": false
  },
  {
   "id": "event.interval",
   "version": 1,
   "category": "event",
   "flow": "event",
   "icon": "timer",
   "name": {
    "ru": "Каждые N минут",
    "en": "Every N minutes"
   },
   "description": {
    "ru": "Запускает команду регулярно через заданное число минут, пока включена автоматизация.",
    "en": "Starts the command regularly every given number of minutes while the automation is enabled."
   },
   "example": {
    "ru": "Каждые 30 минут → напоминание размяться.",
    "en": "Every 30 minutes → stretch reminder."
   },
   "inputs": [
    {
     "id": "minutes",
     "type": "int",
     "label": {
      "ru": "Минуты",
      "en": "Minutes"
     },
     "default": 30,
     "literal": true,
     "min": 1,
     "max": 1440
    }
   ],
   "outputs": [
    {
     "id": "exec",
     "type": "exec",
     "label": {
      "ru": "Запуск",
      "en": "Start"
     }
    },
    {
     "id": "time",
     "type": "time",
     "label": {
      "ru": "Время",
      "en": "Time"
     },
     "default": "00:00"
    }
   ],
   "source": {
    "emits": "time.every",
    "src": "time"
   },
   "executor": {
    "kind": "builtin",
    "ref": "event"
   },
   "capabilities": [
    "trigger.time"
   ],
   "changes_state": false,
   "side_effects": false
  },
  {
   "id": "event.sun",
   "version": 1,
   "category": "event",
   "flow": "event",
   "icon": "sunset",
   "name": {
    "ru": "Рассвет или закат",
    "en": "Sunrise or sunset"
   },
   "description": {
    "ru": "Запускает команду на рассвете или закате (со сдвигом в минутах). Координаты берутся из настроек места оболочки.",
    "en": "Starts the command at sunrise or sunset (with an offset in minutes). Coordinates come from the shell's location settings."
   },
   "example": {
    "ru": "За 15 минут до заката → ночной фильтр.",
    "en": "15 minutes before sunset → night filter."
   },
   "inputs": [
    {
     "id": "kind",
     "type": "text",
     "label": {
      "ru": "Что",
      "en": "Event"
     },
     "default": "sunset",
     "literal": true,
     "choices": [
      "sunrise",
      "sunset"
     ],
     "choice_labels": {
      "ru": {
       "sunrise": "рассвет",
       "sunset": "закат"
      },
      "en": {
       "sunrise": "sunrise",
       "sunset": "sunset"
      }
     }
    },
    {
     "id": "offset",
     "type": "int",
     "label": {
      "ru": "Сдвиг, мин",
      "en": "Offset, min"
     },
     "default": 0,
     "literal": true,
     "min": -180,
     "max": 180
    }
   ],
   "outputs": [
    {
     "id": "exec",
     "type": "exec",
     "label": {
      "ru": "Запуск",
      "en": "Start"
     }
    },
    {
     "id": "time",
     "type": "time",
     "label": {
      "ru": "Время",
      "en": "Time"
     },
     "default": "00:00"
    }
   ],
   "source": {
    "emits": "sun",
    "src": "time"
   },
   "executor": {
    "kind": "builtin",
    "ref": "event"
   },
   "capabilities": [
    "trigger.time"
   ],
   "changes_state": false,
   "side_effects": false
  },
  {
   "id": "event.app_opened",
   "version": 1,
   "category": "event",
   "flow": "event",
   "icon": "window",
   "name": {
    "ru": "Приложение открыто",
    "en": "App opened"
   },
   "description": {
    "ru": "Запускает команду, когда открывается окно приложения. Фильтры по классу и заголовку необязательны (подстрока без учёта регистра; «re:» в начале — регулярное выражение).",
    "en": "Starts the command when an application window opens. Class and title filters are optional (case-insensitive substring; a leading «re:» means a regular expression)."
   },
   "example": {
    "ru": "Открыт Steam → переключить звук на колонки.",
    "en": "Steam opened → switch audio to the speakers."
   },
   "inputs": [
    {
     "id": "class_filter",
     "type": "text",
     "label": {
      "ru": "Класс окна",
      "en": "Window class"
     },
     "default": "",
     "literal": true
    },
    {
     "id": "title_filter",
     "type": "text",
     "label": {
      "ru": "Заголовок содержит",
      "en": "Title contains"
     },
     "default": "",
     "literal": true
    }
   ],
   "outputs": [
    {
     "id": "exec",
     "type": "exec",
     "label": {
      "ru": "Запуск",
      "en": "Start"
     }
    },
    {
     "id": "class",
     "type": "text",
     "label": {
      "ru": "Класс окна",
      "en": "Window class"
     },
     "default": ""
    },
    {
     "id": "title",
     "type": "text",
     "label": {
      "ru": "Заголовок",
      "en": "Title"
     },
     "default": ""
    },
    {
     "id": "workspace",
     "type": "text",
     "label": {
      "ru": "Рабочий стол",
      "en": "Workspace"
     },
     "default": ""
    }
   ],
   "source": {
    "emits": "window.open",
    "src": "hyprland"
   },
   "executor": {
    "kind": "builtin",
    "ref": "event"
   },
   "capabilities": [
    "trigger.windows"
   ],
   "changes_state": false,
   "side_effects": false
  },
